# Imagem publicada pelo GitHub Actions (troque SEU_USUARIO/REPO pelo seu, em minúsculas)
ORBITA_IMAGE=ghcr.io/SEU_USUARIO/orbita:latest

# Domínio apontando (registro A) para o IP da VM
DOMAIN=orbita.seudominio.com.br

# Senha do /admin e do /host
ADMIN_PASSWORD=troque-esta-senha

# Opcional: front hospedado numa CDN (ver README)
# PUBLIC_URL=https://app.seudominio.com.br
# CORS_ORIGINS=https://app.seudominio.com.br
